import { ConversationNodeAssembler } from '../../../deepseek-harness/packages/client/ui-conversation/src/client/conversation/assembler.ts';
import { assistantDefinition } from '../../../deepseek-harness/packages/client/ui-chat/src/client/conversation-nodes/assistant.ts';
import { turnProcessDefinition, processEvidenceDefinition } from '../../../deepseek-harness/packages/client/ui-chat/src/client/conversation-nodes/turn-process.ts';
import { chatViewDefinition } from '../../../deepseek-harness/packages/client/ui-chat/src/client/conversation-nodes/chat-snapshot-builder.ts';
import { processGroupDefinition } from '../../../deepseek-harness/packages/client/ui-chat/src/client/conversation-nodes/process-groups.ts';
import { messageDefinition } from '../../../deepseek-harness/packages/client/ui-chat/src/client/conversation-nodes/message.ts';
import { toolDefinition } from '../../../deepseek-harness/packages/client/ui-chat/src/client/conversation-nodes/tool.ts';
import { ClientAssistantStream } from '../../../deepseek-harness/packages/api/session-controller/src/client/sessions/assistant-stream.ts';
export { ClientAssistantStream };
export function original(entries:any[], metrics?:any){const definitions=[messageDefinition,assistantDefinition,turnProcessDefinition,processEvidenceDefinition,toolDefinition];const assembler=new ConversationNodeAssembler({entries:()=>definitions,fallbackEntry:()=>undefined} as any,{entries:()=>[metrics ? {...chatViewDefinition,create:()=>{const b:any=chatViewDefinition.create();const replace=b.replace.bind(b),apply=b.apply.bind(b);b.replace=(input:any)=>{metrics.replaceCalls=(metrics.replaceCalls??0)+1;return replace(input)};b.apply=(input:any)=>{metrics.applyCalls=(metrics.applyCalls??0)+1;metrics.nodeUpserts=(metrics.nodeUpserts??0)+input.upserts.length;const turns=new Set(input.changedTurns??[]);for(const n of input.upserts){if(n.data.turn!==undefined)turns.add(n.data.turn)}metrics.affectedTurnUpdates=(metrics.affectedTurnUpdates??0)+turns.size;return apply(input)};const values=b.legacy.finalizedContributions.values.bind(b.legacy.finalizedContributions);b.legacy.finalizedContributions.values=function*(){for(const v of values()){metrics.legacyFinalizedEntriesRead=(metrics.legacyFinalizedEntriesRead??0)+1;yield v}};return b}} : chatViewDefinition]} as any,{entries:()=>[processGroupDefinition],forTarget:(t:string)=>t==='chat'?processGroupDefinition:undefined} as any);assembler.replaceWindow(entries,false);assembler.activateTarget('chat');assembler.flush();return assembler;}
export function summary(a:any){const s=a.snapshot('chat'),t=s.timeline.turns.get(1);return {process:t?.data.get('turn-process'),turnStatus:t?.status,steps:t?.steps.map((x:any)=>({step:x.step,status:x.status})),nodes:s.nodes.values().map((n:any)=>({key:n.key,kind:n.kind,anchorSeq:n.anchorSeq,visibility:n.visibility,status:n.data.status,step:n.data.step,blocks:n.data.blocks,final:n.data.finalNode})),grouped:a.grouped('chat')?.entries.map((e:any)=>e.kind==='group'?{...e,group:a.grouped('chat').groupSource(e.key).getSnapshot()}:e)};}
export function metadataOriginal(entries:any[], metrics:any={}){const definitions=[messageDefinition,assistantDefinition,turnProcessDefinition,processEvidenceDefinition,toolDefinition];const take=(input:any,baseline:boolean)=>{metrics[baseline?'replaceCalls':'applyCalls']=(metrics[baseline?'replaceCalls':'applyCalls']??0)+1;metrics.nodeUpserts=(metrics.nodeUpserts??0)+(baseline?input.nodes.length:input.upserts.length);const turns=new Set(input.changedTurns??[]);for(const n of baseline?input.nodes:input.upserts){if(n.data.turn!==undefined)turns.add(n.data.turn)}metrics.affectedTurnUpdates=(metrics.affectedTurnUpdates??0)+turns.size;return{timeline:input.timeline}};const view={target:'chat',create:()=>({empty:{timeline:{turns:new Map()}},replace:(x:any)=>take(x,true),apply:(x:any)=>take(x,false),publish:()=>{}})};const assembler=new ConversationNodeAssembler({entries:()=>definitions,fallbackEntry:()=>undefined} as any,{entries:()=>[view]} as any);assembler.replaceWindow(entries,false);assembler.activateTarget('chat');assembler.flush();return assembler;}
